<?xml version="1.0"?>
<ruleset name="Ratesight">
    <description>Full WordPress standards for Ratesight. Plugin minimums: WordPress 5.9 and PHP 8.0. PHP compatibility validation remains a separate held gate.</description>
    <config name="minimum_wp_version" value="5.9"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ratesight"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ratesight"/>
            </property>
        </properties>
    </rule>
</ruleset>
